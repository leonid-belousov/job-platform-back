{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=recruitment_db;Username=recruitment;Password=recruitment_pwd"
  },
  "Jwt": {
    "Issuer": "RecruitmentPlatform",
    "Audience": "RecruitmentPlatform.Web",
    "Secret": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_MIN_32_CHARS",
    "AccessTokenMinutes": 30
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin123",
    "BucketName": "recruitment-files",
    "UseSsl": false
  },
  "RefreshTokenCleanup": {
    "CleanupIntervalHours": 24,
    "RetentionDaysAfterExpiration": 30
  },
  "Email": {
    "Enabled": false,
    "Provider": "Smtp",
    "FromEmail": "noreply@localhost",
    "FromName": "Recruitment Platform",
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "Username": "",
    "Password": "",
    "TimeoutSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "https://localhost:3000",
      "https://localhost:5173"
    ]
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
